# Copier dans ~/livetchat/.env sur le serveur (chmod 600), puis :
#   venv/bin/python -m livetchat.server.set_password   -> ajoute LTCHAT_PASSWORD_HASH
LTCHAT_PUBLIC_URL=https://VOTRE_IP_PUBLIQUE:8000
LTCHAT_CHANNELS=general,gaming,chill
LTCHAT_SECRET=REMPLACER_PAR_python3_-c_"import secrets;print(secrets.token_hex(32))"
